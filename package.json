{
  "name": "lena-dena-ledger",
  "version": "2.0.0",
  "private": true,
  "description": "Money ledger: React (Vite) frontend + Express API, TypeScript, deployed on Vercel.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
